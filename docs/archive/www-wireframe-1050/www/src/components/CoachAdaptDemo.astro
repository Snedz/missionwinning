---
/*
 * A week, and the same week after Wednesday is gone.
 *
 * Ported from src/components/coach/CoachAdaptDemo.tsx. One thing is recorded
 * here that the port must not quietly upgrade: **this demo runs no engine.**
 * The two weeks are literal arrays in the original and literal arrays here —
 * `adaptPlan` is never called. The hero demo above it genuinely runs
 * `suggestNextSetTarget`; this one is a demonstration of a behaviour, not proof
 * of it, and its copy says so. Turning "here is what adapting looks like" into
 * "here is the engine adapting" would be an invented claim, which is the one
 * thing brand-guidelines § Voice rules out absolutely.
 *
 * Vanilla, for the same reason as the hero: a two-state toggle does not justify
 * shipping React to a marketing page.
 *
 * The original calls `prefersReducedMotion()` inside a useState initializer,
 * which is a hydration mismatch waiting to happen under SSR — the audit flagged
 * it, and it is moot here because there is no hydration: the server renders the
 * planned week and script only swaps text.
 */
type Session = { day: string; label: string; kind: 'strength' | 'conditioning' | 'mobility' | 'rest' };

const PLANNED: Session[] = [
  { day: 'Mon', label: 'Lower', kind: 'strength' },
  { day: 'Tue', label: 'Mobility', kind: 'mobility' },
  { day: 'Wed', label: 'Upper', kind: 'strength' },
  { day: 'Thu', label: 'Rest', kind: 'rest' },
  { day: 'Fri', label: 'Conditioning', kind: 'conditioning' },
  { day: 'Sat', label: 'Rest', kind: 'rest' },
  { day: 'Sun', label: 'Rest', kind: 'rest' },
];

const ADAPTED: Session[] = [
  { day: 'Mon', label: 'Lower', kind: 'strength' },
  { day: 'Tue', label: 'Mobility', kind: 'mobility' },
  { day: 'Wed', label: 'Missed', kind: 'rest' },
  { day: 'Thu', label: 'Upper', kind: 'strength' },
  { day: 'Fri', label: 'Rest', kind: 'rest' },
  { day: 'Sat', label: 'Conditioning', kind: 'conditioning' },
  { day: 'Sun', label: 'Rest', kind: 'rest' },
];
---

<div
  class="border-2 border-rule bg-card p-5"
  data-adapt-demo
  data-planned={JSON.stringify(PLANNED)}
  data-adapted={JSON.stringify(ADAPTED)}
>
  <div class="flex items-baseline justify-between gap-3">
    <p class="eyebrow">Demo · a week, adapted</p>
    <p class="eyebrow" data-state>Planned</p>
  </div>

  <!-- Cells are flush left, like everything else. The first draft centred them —
       a seven-column grid feels like the exception — and the ban-list rule
       caught it the same day the rule was written. It reads fine left-aligned,
       so there was no exception to argue for. -->
  <ol class="mt-4 grid grid-cols-7 gap-0.5 border-2 border-rule bg-rule" data-week>
    {PLANNED.map((s) => (
      <li class="flex flex-col gap-1 bg-paper px-2 py-3">
        <span class="eyebrow">{s.day}</span>
        <span
          class={`text-[12px] font-semibold leading-tight ${s.kind === 'rest' ? 'text-quiet' : 'text-ink'}`}
          data-label
        >
          {s.label}
        </span>
      </li>
    ))}
  </ol>

  <div class="mt-4 min-h-[4.5rem] border-2 border-rule bg-paper px-3 py-2.5" aria-live="polite" data-note>
    <p class="text-[14px] leading-[1.5] text-quiet">
      A planned week. Miss a day and the rest of it moves — the dose is kept, not dropped.
    </p>
  </div>

  <button
    type="button"
    class="mt-4 flex min-h-[44px] w-full items-center justify-center gap-2 border-2 border-red bg-tint py-3 text-[15px] font-semibold text-ink transition-colors hover:bg-red hover:text-paper"
    data-toggle
  >
    Miss Wednesday
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-adapt-demo]');
  if (root) {
    const planned = JSON.parse(root.dataset.planned ?? '[]');
    const adapted = JSON.parse(root.dataset.adapted ?? '[]');
    const cells = [...root.querySelectorAll<HTMLElement>('[data-label]')];
    const state = root.querySelector<HTMLElement>('[data-state]');
    const note = root.querySelector<HTMLElement>('[data-note]');
    const toggle = root.querySelector<HTMLElement>('[data-toggle]');

    let missed = false;

    function render() {
      const week = missed ? adapted : planned;
      cells.forEach((cell, i) => {
        const s = week[i];
        if (!s) return;
        cell.textContent = s.label;
        cell.className = `text-[12px] font-semibold leading-tight ${
          s.kind === 'rest' ? 'text-quiet' : 'text-ink'
        }`;
      });
      if (state) state.textContent = missed ? 'Adapted' : 'Planned';
      if (note) {
        note.innerHTML = missed
          ? '<p class="text-[14px] leading-[1.5] text-quiet">Wednesday is gone, so upper body moved to Thursday and conditioning to Saturday. Same week, same dose.</p>'
          : '<p class="text-[14px] leading-[1.5] text-quiet">A planned week. Miss a day and the rest of it moves — the dose is kept, not dropped.</p>';
      }
      if (toggle) toggle.textContent = missed ? 'Reset the week' : 'Miss Wednesday';
    }

    toggle?.addEventListener('click', () => {
      missed = !missed;
      render();
    });
  }
</script>
