---
/*
 * One rhythm tier per section, so the spacing is chosen from a scale rather
 * than typed. `www-rhythm.mjs` measures the result at 1440 against the
 * reference band (DESIGN_RESEARCH Wave 10 §10.4) — a section that picks its own
 * padding is a section that drifts out of it.
 */
interface Props {
  tier?: 'section' | 'statement';
  id?: string;
  rule?: boolean;
  class?: string;
}

const { tier = 'section', id, rule = true, class: className = '' } = Astro.props;

const pad =
  tier === 'statement'
    ? 'py-statement lg:py-statement-lg'
    : 'py-section lg:py-section-lg';
---

<section id={id} class={`${rule ? 'rule-top' : ''} px-5 sm:px-8 ${pad} ${className}`}>
  <div class="mx-auto max-w-6xl">
    <slot />
  </div>
</section>
