# Mission Winning — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is gitignored).

# ─── Private development gate (REQUIRED on Vercel before public sees the app) ───
# Strong random string — use: openssl rand -base64 32
PRIVATE_ACCESS_SECRET=
# Optional comma-separated aliases accepted at /private (cookies still signed with PRIVATE_ACCESS_SECRET)
# PRIVATE_ACCESS_CODES=Done

# Gate on in production (default). Set to false when ready to go fully public.
PRIVATE_MODE=true

# Optional: allow Supabase magic-link sessions to bypass the gate (NOT recommended).
# Default is off — use the access code instead, then sign in inside the app.
# PRIVATE_ALLOW_AUTH_BYPASS=false

# ─── Supabase (auth, cloud sync, premium enrollments) ───
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth (Supabase Dashboard → Authentication → Providers):
# - Enable Google (Client ID + Secret from Google Cloud Console)
# - Apple is OFF in the app until you finish Apple Developer setup (see ENV.md)
# NEXT_PUBLIC_OAUTH_GOOGLE=false   # hide Google button (default: show when Supabase configured)
# NEXT_PUBLIC_OAUTH_APPLE=true     # show Apple button only after Supabase Apple provider is fully configured
# - Add redirect URL: http://localhost:3000/auth/callback (dev)
# - Add redirect URL: https://www.missionwinning.com/auth/callback (prod)

# Server-only (webhooks / admin — never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (optional — Resend for receipts / program delivery) ───
# RESEND_API_KEY=re_...
# RESEND_FROM=Mission Winning <hello@missionwinning.com>
# NEXT_PUBLIC_APP_URL=https://www.missionwinning.com

# ─── Beta admin (founder funnel dashboard on Profile) ───
# Comma-separated emails allowed to view /api/beta/metrics
# BETA_ADMIN_EMAILS=you@email.com
# Optional header secret for curl/scripts: BETA_ADMIN_SECRET=

# ─── Stripe (Checkout Sessions + webhook — see docs/STRIPE_PREMIUM_SETUP.md) ───
# Preferred: server Checkout Sessions. Set NEXT_PUBLIC_STRIPE_CHECKOUT=true when ready.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_BUNDLE_MONTHLY=price_...
# STRIPE_PRICE_BUNDLE_12MO=price_...
# STRIPE_PRICE_BUNDLE_LIFETIME=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_CHECKOUT=true
# NEXT_PUBLIC_APP_URL=https://www.missionwinning.com
# Fallback Payment Links (optional while migrating):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE=https://buy.stripe.com/...          # default / annual
# NEXT_PUBLIC_STRIPE_LINK_PREMIUM=https://buy.stripe.com/...         # alias for bundle link
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE_MONTHLY=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE_3MO=https://buy.stripe.com/...      # legacy
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE_12MO=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE_LIFETIME=https://buy.stripe.com/...

# ─── Phantom Solana USDC lifetime (optional — docs/PHANTOM_USDC_CHECKOUT.md) ───
# NEXT_PUBLIC_CRYPTO_CHECKOUT=true
# NEXT_PUBLIC_PHANTOM_APP_ID=
# SOLANA_TREASURY_ADDRESS=
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ─── Demo mode (local dev only — never true in production) ───
# DEMO_PREMIUM=false

# ─── PayPal webhook (signature verification via REST API) ───
# PAYPAL_WEBHOOK_ID=          # From PayPal Developer → Webhooks
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox           # sandbox | live
# PAYPAL_API_BASE=             # optional override (default api-m.sandbox.paypal.com or live)

# ─── Content Security Policy ───
# CSP_ENFORCE=true             # default: enforce in production, report-only in dev

# ─── Retention nudges (optional — daily reminder emails via cron) ───
# CRON_SECRET=<openssl rand -base64 32>  # Vercel sends it as Bearer auth to /api/cron/nudges
# NUDGE_SECRET=                          # HMAC for unsubscribe links (defaults to PRIVATE_ACCESS_SECRET)

# ─── Product analytics (optional — PostHog; off unless key set) ───
# Anonymous-first: no autocapture, no session recording, DNT respected.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Error monitoring (optional — Sentry; off unless DSN set) ───
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=mission-winning
# SENTRY_AUTH_TOKEN=...   # CI/Vercel build only — uploads source maps (never NEXT_PUBLIC_)

# ─── AI Coach (optional — daily insight / plan voice) ───
# Omit all four to use pure rule-based coach (zero third-party LLM).
# Prefer SpaceXAI/xAI with team-level Zero Data Retention (ZDR) in Console:
#   https://docs.x.ai/developers/faq/security#what-is-zero-data-retention-zdr
# Stateless chat completions only — never Files/Collections/Batch/stateful Responses.
# COACH_LLM_API_URL=https://api.x.ai/v1/chat/completions
# COACH_LLM_API_KEY=xai-...          # console.x.ai — never NEXT_PUBLIC_
# COACH_LLM_MODEL=grok-4.5           # pin a current slug from docs.x.ai/developers/models
# COACH_LLM_REQUIRE_ZDR=true         # production recommended: fail closed unless header is true

# ─── Web push (optional — dark until public flip; SW only when PRIVATE_MODE=false prod) ───
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@missionwinning.com

# ─── Founder weekly digest (optional — Monday 16:00 UTC cron) ───
# FOUNDER_DIGEST_EMAIL=you@example.com

# ─── U.S. National Fitness track (optional — global app unchanged) ───
# NEXT_PUBLIC_AMERICA_TRACK_ENABLED=true   # default OFF (opt-in); set true to show PFT /america track
# NEXT_PUBLIC_LEADERBOARD_PACERS=false     # default on; set false to remove labeled Pacer bots from boards
# NEXT_PUBLIC_SHOW_MAHA_COPY=false         # set true for MAHA marketing copy (legal review first)
# NEXT_PUBLIC_COUNCIL_STATUS=aspirational  # aspirational | pending | member
# YOUTH_CONSENT_SECRET=                   # HMAC for parent verify codes (defaults to PRIVATE_ACCESS_SECRET)

# Canonical site (use www in production)
# NEXT_PUBLIC_SITE_URL=https://www.missionwinning.com
