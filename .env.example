# Mission Winning — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is gitignored).

# ─── Private development gate (REQUIRED on Vercel before public sees the app) ───
# Strong random string — use: openssl rand -base64 32
PRIVATE_ACCESS_SECRET=

# Gate on in production (default). Set to false when ready to go fully public.
PRIVATE_MODE=true

# Optional: allow Supabase magic-link sessions to bypass the gate (NOT recommended).
# Default is off — use the access code instead, then sign in inside the app.
# PRIVATE_ALLOW_AUTH_BYPASS=false

# ─── Supabase (auth, cloud sync, premium enrollments) ───
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth (Supabase Dashboard → Authentication → Providers):
# - Enable Google (Client ID + Secret from Google Cloud Console)
# - Apple is OFF in the app until you finish Apple Developer setup (see ENV.md)
# NEXT_PUBLIC_OAUTH_GOOGLE=false   # hide Google button (default: show when Supabase configured)
# NEXT_PUBLIC_OAUTH_APPLE=true     # show Apple button only after Supabase Apple provider is fully configured
# - Add redirect URL: http://localhost:3000/auth/callback (dev)
# - Add redirect URL: https://www.missionwinning.com/auth/callback (prod)

# Server-only (webhooks / admin — never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (optional — Resend for receipts / program delivery) ───
# RESEND_API_KEY=re_...
# RESEND_FROM=Mission Winning <hello@missionwinning.com>
# NEXT_PUBLIC_APP_URL=https://www.missionwinning.com

# ─── Beta admin (founder funnel dashboard on Profile) ───
# Comma-separated emails allowed to view /api/beta/metrics
# BETA_ADMIN_EMAILS=you@email.com
# Optional header secret for curl/scripts: BETA_ADMIN_SECRET=

# ─── Stripe (future — payment links + webhook) ───
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# NEXT_PUBLIC_STRIPE_LINK_BUNDLE=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_LINK_PREMIUM=https://buy.stripe.com/...  # alias for bundle link
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Demo mode (local dev only — never true in production) ───
# DEMO_PREMIUM=false

# ─── PayPal webhook (signature verification via REST API) ───
# PAYPAL_WEBHOOK_ID=          # From PayPal Developer → Webhooks
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox           # sandbox | live
# PAYPAL_API_BASE=             # optional override (default api-m.sandbox.paypal.com or live)

# ─── Content Security Policy ───
# CSP_ENFORCE=true             # default: enforce in production, report-only in dev

# ─── AI Coach (optional — daily insight on Today) ───
# OpenAI-compatible chat completions endpoint + key. Omit to use rule-based coach only.
# COACH_LLM_API_URL=https://api.openai.com/v1/chat/completions
# COACH_LLM_API_KEY=sk-...
# COACH_LLM_MODEL=gpt-4o-mini

# ─── U.S. National Fitness track (optional — global app unchanged) ───
# NEXT_PUBLIC_AMERICA_TRACK_ENABLED=true   # default on; set false to hide PFT /america
# NEXT_PUBLIC_SHOW_MAHA_COPY=false         # set true for MAHA marketing copy (legal review first)
# NEXT_PUBLIC_COUNCIL_STATUS=aspirational  # aspirational | pending | member
