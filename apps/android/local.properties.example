## This file is gitignored. Copy to local.properties and edit.

# SDK path (Android Studio usually writes this automatically)
# sdk.dir=/Users/YOU/Library/Android/sdk

# Optional: point debug builds at local Next.js (emulator → host)
# mw.apiBaseUrl=http://10.0.2.2:3000

# Optional: PRIVATE_MODE cookie value (mw_private_access token after POST /api/private-access)
# mw.privateAccessCookie=

# Optional: Supabase Auth for email OTP (Account screen). Same project as web.
# mw.supabaseUrl=https://YOUR-PROJECT.supabase.co
# mw.supabaseAnonKey=your-anon-key

# Optional: Sentry DSN for crash-only reporting (Account can disable).
# mw.sentryDsn=https://KEY@oORG.ingest.sentry.io/PROJECT
