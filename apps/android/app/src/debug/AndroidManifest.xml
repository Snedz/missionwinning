<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. See src/debug/res/xml/network_security_config.xml
  for why: main pins usesCleartextTraffic="false", so a debug build cannot reach
  a local API server at all. Only src/debug/ carries this, so release is
  unchanged.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
