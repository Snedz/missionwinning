<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold start / splash: solid navy so first frame matches Compose canvas -->
    <style name="Theme.MissionWinning.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0C10</item>
        <item name="android:navigationBarColor">#0A0C10</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.MissionWinning" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0C10</item>
        <item name="android:navigationBarColor">#0A0C10</item>
        <item name="android:windowBackground">#0A0C10</item>
    </style>
</resources>
