{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/programs", "destination": "/learn", "permanent": false },
    { "source": "/beta", "destination": "/bundle", "permanent": false }
  ]
}
