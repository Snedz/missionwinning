# Copy to .env.local and fill real values for revenue + auth + sync + webhooks

# Supabase (create free project at supabase.com — get from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Publishable (for future dynamic checkout; Payment Links work without this)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Payment Links (create in Stripe Dashboard > Payment Links)
# One-time high-ticket Beta Founders programs (PT+Nutrition, Bodybuilding, etc.)
# + recurring for Premium sub
NEXT_PUBLIC_STRIPE_LINK_PT=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_BB=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_CORR=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_BUS=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_COACH=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_COND=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=https://buy.stripe.com/...   # recurring monthly premium sub

# Server-only for webhooks (fulfillment for BOTH one-time purchases and active subscriptions)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Resend (emails for receipts, program delivery, onboarding)
RESEND_API_KEY=re_...

# Note: After Stripe checkout (one-time or sub), the /api/stripe-webhook route (Next.js)
# will receive events, grant premium in Supabase enrollments/subs, and trigger Resend emails
# with signed PDF links from Storage. See plan.md Deployment section and SETUP.md.

# PWA + domain: Deploy to Vercel, point www.missionwinning.com (and apex) via DNS.
# Web browser mobile first PWA is the primary (zero fees, global). Native later.
