{
  "name": "missionwinning-v2",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": ["apps/web", "packages/core"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w packages/core",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
