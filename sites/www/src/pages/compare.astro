---
/*
 * /compare — commissioned Astro compare index.
 *
 * Additive. Next keeps the three /guide/mission-winning-vs-* SEO URLs.
 * This file is an index only. No host flip. No _redirects.
 */
import Base from '../layouts/Base.astro';
import CtaSlot from '../components/CtaSlot.astro';
import StagePhoto from '../components/StagePhoto.astro';
import { appUrl } from '../lib/appLinks';
import { META, HERO, STORIES } from '../lib/compareContent';
---

<Base title={META.title} description={META.description}>
  <header
    class="on-dark fixed inset-x-0 top-0 z-50 border-b-2 border-transparent transition-colors duration-200"
    data-nav
  >
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-4 sm:px-8">
      <a href="/" class="flex shrink-0 items-center gap-3">
        <span
          class="flex h-8 w-8 items-center justify-center bg-paper text-[13px] font-extrabold tracking-[-0.04em] text-ink"
          data-nav-mark>MW</span
        >
        <span class="text-[15px] font-extrabold tracking-[-0.01em]">Mission Winning</span>
      </a>
      <a href="/" class="hidden text-[15px] font-semibold hover:underline md:inline">Homepage</a>
      <CtaSlot variant="quiet" terminal class="ml-auto shrink-0" />
    </div>
  </header>

  <main>
    <section
      class="stage on-dark flex min-h-[72svh] flex-col justify-end px-5 pb-14 pt-32 sm:px-8 lg:pb-20 lg:pt-40"
    >
      <StagePhoto
        base="/photo/home-rack"
        alt="A home rack — train anywhere, no gym required"
        position="50% 40%"
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <p class="eyebrow eyebrow-live">{HERO.eyebrow}</p>
        <h1 class="display-hero-www rise mt-5 max-w-[14ch]">
          {HERO.lines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="mt-6 max-w-[52ch] text-[19px] leading-[1.5] text-quiet">{HERO.body}</p>
      </div>
    </section>

    <div class="px-5 pb-16 pt-16 sm:px-8">
    <div class="mx-auto max-w-3xl">

      <ol class="mt-12 border-y-2 border-rule">
        {
          STORIES.map((story) => (
            <li class="border-b-2 border-rule last:border-b-0">
              <a href={appUrl(story.path)} class="block py-5 hover:underline">
                <p class="text-[17px] font-extrabold">{story.title}</p>
                <p class="mt-1 text-[15px] leading-snug text-quiet">{story.subtitle}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    </div>
  </main>

  <footer class="poster-field px-5 py-statement sm:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="display-statement wipe"><span>Start with one set.</span></p>
      <CtaSlot terminal class="mt-10 max-w-[420px]" />
    </div>
  </footer>
</Base>
