---
/*
 * /vision — commissioned Astro vision page.
 *
 * Additive. Next keeps www.missionwinning.com and Next /vision.
 * This file is the fourth-surface vision page only.
 * No national-fitness track. No host flip. No _redirects.
 */
import Base from '../layouts/Base.astro';
import PtnNav from '../components/PtnNav.astro';
import PtnClose from '../components/PtnClose.astro';
import StagePhoto from '../components/StagePhoto.astro';
import { appUrl } from '../lib/appLinks';
import { META, HERO, SECTIONS } from '../lib/visionContent';
---

<Base title={META.title} description={META.description}>
  <PtnNav terminal />

  <main>
    <section
      class="stage on-dark flex min-h-[72svh] flex-col justify-end px-5 pb-14 pt-32 sm:px-8 lg:pb-20 lg:pt-40"
    >
      <StagePhoto
        base="/photo/phone-bench"
        alt="A phone on a bench — the logger is the product"
        position="50% 50%"
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <p class="eyebrow eyebrow-live">{HERO.eyebrow}</p>
        <h1 class="display-hero-www rise mt-5 max-w-[14ch]">
          {HERO.lines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="mt-6 max-w-[52ch] text-[19px] leading-[1.5] text-quiet">
          {HERO.body}
        </p>
      </div>
    </section>

    {
      SECTIONS.map((section, i) =>
        i === 1 ? (
          <section class="stage on-dark flex min-h-[72svh] flex-col justify-end px-5 pb-14 pt-24 sm:px-8 lg:pb-20">
            <StagePhoto
              base="/photo/home-rack"
              alt=""
              position="40% 50%"
              drift
            />
            <div class="stage-body mx-auto w-full max-w-6xl">
              <p class="eyebrow eyebrow-live">{section.index}</p>
              <h2 class="display-section mt-4 max-w-[24ch]">{section.title}</h2>
              {section.body.map((p) => (
                <p class="mt-4 max-w-[52ch] text-[17px] leading-[1.55] text-quiet">{p}</p>
              ))}
            </div>
          </section>
        ) : (
          <section class="px-5 py-section sm:px-8 lg:py-section-lg">
            <div class="mx-auto max-w-3xl">
              <p class="eyebrow">{section.index}</p>
              <h2 class="display-section mt-4 max-w-[24ch]">{section.title}</h2>
            {section.body.map((p) => (
              <p class="mt-4 max-w-[62ch] text-[17px] leading-[1.55] text-quiet">{p}</p>
            ))}
          </div>
        </section>
        )
      )
    }
  </main>

  <PtnClose line="The logger stays free." />

  <div class="ground-ink px-5 py-6 sm:px-8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2">
      <p class="eyebrow">&copy; Mission Winning</p>
      <a href="/" class="eyebrow underline">Homepage</a>
      <a href="/about" class="eyebrow underline">About</a>
      <a href={appUrl('/privacy')} class="eyebrow underline">Privacy</a>
      <a href={appUrl('/terms')} class="eyebrow underline">Terms</a>
    </div>
  </div>
</Base>
