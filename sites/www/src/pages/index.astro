---
/*
 * Unsigned Patreon homepage on our skeleton.
 *
 * Sequence is still log → adapt → anywhere → free → start. Copy stays in
 * homeContent.ts. Chrome is PtnNav. Photography is a ground, not a card.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CtaSlot from '../components/CtaSlot.astro';
import PtnNav from '../components/PtnNav.astro';
import PtnClose from '../components/PtnClose.astro';
import StagePhoto from '../components/StagePhoto.astro';
import LogToPlanDemo from '../components/LogToPlanDemo.astro';
import CoachAdaptDemo from '../components/CoachAdaptDemo.astro';
import {
  META, HERO, STATS, STATEMENTS, ADAPT, ANYWHERE, FREE_CORE, QUESTIONS,
} from '../lib/homeContent';
---

<Base
  title={META.title}
  description={META.description}
>
  <PtnNav />

  <main>
    <!-- 01 LOG. Full-bleed photograph. Alt is ready for /photo/hero. -->
    <section class="stage on-dark ptn-on-dark flex min-h-[92svh] flex-col justify-end px-5 pb-14 pt-32 sm:px-8 lg:pb-56 lg:pt-40">
      <StagePhoto
        base="/photo/home-rack"
        alt="Garage training set — slot for /photo/hero. A loaded barbell on a home rack until that file lands."
        position="52% 38%"
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end lg:gap-14">
          <div>
            <p class="eyebrow eyebrow-live">{HERO.eyebrow}</p>
            <h1 class="display-hero-www rise mt-5 max-w-[15ch]">
              {HERO.lines.map((line) => <span>{line}</span>)}
            </h1>
            <p class="mt-6 max-w-[54ch] text-[19px] leading-[1.5] text-quiet">
              {HERO.body}
            </p>
            <CtaSlot class="mt-9 max-w-[420px]" />
          </div>
          <div class="ground-paper lg:mb-[-5rem]">
            <LogToPlanDemo />
          </div>
        </div>
      </div>
    </section>

    <!-- 02 STATEMENT. Second image ground. Alt ready for /photo/hero-2. -->
    <section class="stage on-dark flex min-h-[62svh] items-center px-5 py-statement sm:px-8 lg:py-statement-lg">
      <StagePhoto
        base="/photo/bare-wrist"
        alt="Bedroom dumbbells — slot for /photo/hero-2. A bare wrist on a barbell until that file lands."
        position="50% 30%"
        drift
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <p class="display-statement wipe"><span>{STATEMENTS.missed}</span></p>
      </div>
    </section>

    <!-- 03 TRAIN -->
    <Section id="train">
      <p class="eyebrow">Train</p>
      <h2 class="display-section mt-4 max-w-[24ch]">{HERO.lines[0]}</h2>
      <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.6] text-quiet">
        {HERO.body}
      </p>
      <div class="ptn-card mt-10 ptn-pad">
        <LogToPlanDemo />
      </div>
    </Section>

    <!-- 04 HISTORY — photograph as ground so composition stays over 35%. -->
    <section id="history" class="stage on-dark flex min-h-[72svh] flex-col justify-end px-5 pb-14 pt-24 sm:px-8 lg:pb-20">
      <StagePhoto
        base="/photo/phone-bench"
        alt="History month — slot for /photo/history-month. A phone on a bench until that file lands."
        position="50% 55%"
        drift
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <p class="eyebrow">History</p>
        <h2 class="display-section mt-4 max-w-[24ch]">The log is the record</h2>
        <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.5] text-quiet">
          Sets save on the device the moment you log them. Signal is optional; the log is not.
        </p>
        <dl class="mt-10 grid gap-4 sm:grid-cols-2">
          {STATS.map((s) => (
            <div class="ptn-card ptn-pad flex flex-col gap-3 ground-paper">
              <dt class="ptn-name">{s.figure}</dt>
              <dd class="ptn-quiet">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 05 ADAPT -->
    <Section id="adapt">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
        <div>
          <p class="eyebrow">{ADAPT.eyebrow}</p>
          <h2 class="display-section mt-4 max-w-[24ch]">{ADAPT.heading}</h2>
          <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.6] text-quiet">
            {ADAPT.body}
          </p>
        </div>
        <div class="ptn-card ptn-pad">
          <CoachAdaptDemo />
        </div>
      </div>
    </Section>

    <!-- 06 ANYWHERE -->
    <section id="anywhere" class="rule-top px-5 py-section sm:px-8 lg:py-section-lg">
      <div class="mx-auto max-w-6xl">
        <p class="eyebrow">{ANYWHERE.eyebrow}</p>
        <h2 class="display-section mt-4 max-w-[24ch]">{ANYWHERE.heading}</h2>
      </div>

      <div class="mt-12 grid gap-0.5 bg-rule md:grid-cols-3">
        {ANYWHERE.panels.map((p, i) => (
          <figure class="stage on-dark relative flex min-h-[78svh] items-end md:min-h-[86svh]">
            <StagePhoto base={p.base} alt={p.alt} position={i === 1 ? '50% 60%' : '50% 45%'} drift />
            <figcaption class="stage-body slab w-full px-5 py-6 sm:px-6">
              <p class="text-[19px] font-extrabold tracking-[-0.01em]">{p.title}</p>
              <p class="mt-2 max-w-[36ch] text-[15px] leading-[1.5] text-quiet">{p.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 07 FREE CORE -->
    <section id="free" class="ground-ink ptn-on-dark px-5 py-section sm:px-8 lg:py-section-lg">
      <div class="mx-auto max-w-6xl">
        <p class="eyebrow">{FREE_CORE.eyebrow}</p>
        <h2 class="display-section mt-4 max-w-[24ch]">{FREE_CORE.heading}</h2>
        <dl class="mt-10 divide-y divide-rule border-y border-rule">
          {FREE_CORE.rows.map((row) => (
            <div class="grid gap-2 py-5 sm:grid-cols-[14rem_1fr] sm:gap-8">
              <dt class="text-[17px] font-extrabold tracking-[-0.01em]">{row.term}</dt>
              <dd class="max-w-[62ch] text-[16px] leading-[1.6] text-quiet">{row.def}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 max-w-[62ch] text-[15px] leading-[1.6] text-quiet">
          {FREE_CORE.footnote}
        </p>
        <CtaSlot variant="quiet" class="mt-9" />
      </div>
    </section>

    <!-- 08 QUESTIONS -->
    <Section id="questions">
      <p class="eyebrow">{QUESTIONS.eyebrow}</p>
      <h2 class="display-section mt-4 max-w-[24ch]">{QUESTIONS.heading}</h2>
      <div class="mt-10 max-w-3xl divide-y divide-rule border-y border-rule">
        {QUESTIONS.items.map((item) => (
          <details class="faq py-2">
            <summary class="flex items-center gap-4 py-3 text-[17px] font-extrabold tracking-[-0.01em]">
              {item.q}
            </summary>
            <p class="max-w-[62ch] pb-4 text-[16px] leading-[1.6] text-quiet">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </Section>
  </main>

  <PtnClose line={STATEMENTS.close} terminal={false} />
</Base>
