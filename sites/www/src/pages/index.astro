---
/*
 * The homepage. Nine sections, compact and desktop as separate compositions.
 *
 * Section order is unchanged from src/page-components/LandingPage.tsx, whose own
 * header states it: "log → adapt → anywhere → free → start. That sequence is
 * real, so the page can be read top to bottom as one argument."
 *
 * What changed at `.641` is the composition, and Wave 11 is why. The first build
 * matched the reference type scale (§10.2) and the reference rhythm (§10.4) and
 * still rendered as a wireframe, because nothing had ever measured the axis that
 * actually separates the two: **imagery**. References run 76–81% image area and
 * put a photograph under 81–100% of the first screen; this page ran ~4% and ~0%.
 *
 * Ground plan, and it is sourced rather than chosen (§11.3). No reference
 * alternates ground per section — changes run 0–6 across a whole page, and the
 * pages that change most do it to introduce exactly ONE contrasting field. So:
 *
 *   01 hero        photographic ground   ← image at the top
 *   02 statement   photographic ground   ← image at a statement moment
 *   03 at a glance paper (the dominant ground)
 *   04 adapt       paper
 *   05 anywhere    photographic band
 *   06 free core   INK — the one contrasting field, about two-thirds down
 *   07 compare     paper
 *   08 questions   paper
 *   09 close       red
 *
 * The action repeats on the cadence §11.4 measured (Freeletics Nutrition runs
 * one string every 740–1000pt) but only ONE instance is red. The others invert
 * to paper or ink. Repeating the action is the brief; repeating the red would
 * break the one-red-action contract, and the two are separable.
 *
 * Every string comes from the app's locale pack and every number from the floors
 * module — build-time imports, never shipped to the browser.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CtaSlot from '../components/CtaSlot.astro';
import StagePhoto from '../components/StagePhoto.astro';
import LogToPlanDemo from '../components/LogToPlanDemo.astro';
import CoachAdaptDemo from '../components/CoachAdaptDemo.astro';
import { appUrl } from '../lib/appLinks';
import {
  META, HERO, STATS, STATEMENTS, ADAPT, ANYWHERE, FREE_CORE, COMPARE, QUESTIONS, NAV_LINKS,
} from '../lib/homeContent';

/*
 * Copy, counts and section content come from ../lib/homeContent — the single
 * source the eight art-direction variants under docs/design/variants/ also
 * read. They lived here until `.643`, which was fine while there was one
 * rendering of them; with nine, copy living in the page that renders it makes
 * the comparison board meaningless the first time either side is edited.
 */
---

<Base
  title={META.title}
  description={META.description}
>
  <!-- 00 NAV. Sits on the photographic hero, so it starts transparent with paper
       type and swaps to a paper bar once the hero is behind you. The swap is a
       class toggled by an IntersectionObserver on a 1px sentinel — no scroll
       handler, nothing that runs per frame. -->
  <header
    class="on-dark fixed inset-x-0 top-0 z-50 border-b-2 border-transparent transition-colors duration-200"
    data-nav
  >
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-4 sm:px-8">
      <a href="/" class="flex shrink-0 items-center gap-3">
        <span
          class="flex h-8 w-8 items-center justify-center bg-paper text-[13px] font-extrabold tracking-[-0.04em] text-ink"
          data-nav-mark>MW</span
        >
        <span class="text-[15px] font-extrabold tracking-[-0.01em]">Mission Winning</span>
      </a>
      <!-- Desktop composition: five links. Compact drops them entirely rather
           than hiding them behind a menu button — a marketing page is a scroll,
           and a hamburger on a one-page scroll is chrome pretending to be
           navigation. -->
      <nav class="ml-8 hidden items-center gap-6 md:flex">
        {NAV_LINKS.map((l) => (
          <a href={l.href} class="text-[15px] font-semibold hover:underline">{l.label}</a>
        ))}
      </nav>
      <CtaSlot variant="quiet" class="ml-auto shrink-0" />
    </div>
  </header>

  <main>
    <!-- 01 LOG. The photograph is the ground and the headline is on it. Wave 11
         §11.3: six of ten reference captures put an image under 80–100% of the
         first 900pt, and 40–100% of their text spans fall inside an image box. -->
    <!-- The demo's negative bottom margin (below) pulls the hero's last text
         down by 80px, which comes straight out of the boundary to the statement
         that follows. `lg:pb-56` pays it back and then some — the rhythm guard
         read 438px against a 540–830 statement band before it did. -->
    <section class="stage on-dark flex min-h-[92svh] flex-col justify-end px-5 pb-14 pt-32 sm:px-8 lg:pb-56 lg:pt-40">
      <StagePhoto
        base="/photo/home-rack"
        alt="A loaded barbell on a home rack"
        position="52% 38%"
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end lg:gap-14">
          <div>
            <p class="eyebrow eyebrow-live">{HERO.eyebrow}</p>
            <h1 class="display-hero-www rise mt-5 max-w-[15ch]">
              {HERO.lines.map((line) => <span>{line}</span>)}
            </h1>
            <p class="mt-6 max-w-[54ch] text-[19px] leading-[1.5] text-quiet">
              {HERO.body}
            </p>
            <CtaSlot class="mt-9 max-w-[420px]" />
          </div>

          <!-- The demo overlaps the lower edge of the photograph rather than
               sitting in a column beside it. Its no-JS state is computed at
               build time from the same engine, so the slot is correct before any
               script runs and does not change height when one does. -->
          <!-- `ground-paper` re-establishes the light palette inside a section
               that inverted it. Without it the card renders its own eyebrow and
               quiet text paper-on-paper, which is what the first render did. -->
          <div class="ground-paper lg:mb-[-5rem]">
            <LogToPlanDemo />
          </div>
        </div>
      </div>
    </section>

    <!-- 02 STATEMENT. The second image ground, at the statement moment. -->
    <section class="stage on-dark flex min-h-[62svh] items-center px-5 py-statement sm:px-8 lg:py-statement-lg">
      <StagePhoto
        base="/photo/bare-wrist"
        alt=""
        position="50% 30%"
        drift
      />
      <div class="stage-body mx-auto w-full max-w-6xl">
        <p class="display-statement wipe"><span>{STATEMENTS.missed}</span></p>
      </div>
    </section>

    <!-- 03 AT A GLANCE. Back to paper, the dominant ground. The gutters ARE the
         rules — 2px gap over a rule-coloured parent. -->
    <Section rule={false}>
      <p class="eyebrow">At a glance</p>
      <dl class="mt-8 grid grid-cols-2 gap-0.5 border-2 border-rule bg-rule sm:grid-cols-4">
        {STATS.map((s) => (
          <div class="flex flex-col gap-3 bg-paper p-6">
            <!-- `data-stat-figure`, not `data-count`: LogToPlanDemo already owns
                 a bare `data-count` for its 0/3 progress line, and a global
                 querySelectorAll('[data-count]') here picked it up. It happened
                 to be harmless — a bare attribute reads as '' and fails the
                 numeric test below — which is the kind of luck that stops being
                 luck the day someone gives that attribute a value. -->
            <dt class="display-mega text-poster" data-stat-figure={s.figure}>{s.figure}</dt>
            <dd class="eyebrow">{s.label}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <!-- 04 ADAPT -->
    <Section id="adapt">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
        <div>
          <p class="eyebrow">{ADAPT.eyebrow}</p>
          <h2 class="display-section mt-4 max-w-[24ch]">{ADAPT.heading}</h2>
          <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.6] text-quiet">
            {ADAPT.body}
          </p>
        </div>
        <CoachAdaptDemo />
      </div>
    </Section>

    <!-- 05 ANYWHERE. Three photographic panels edge to edge, no gaps and no
         borders, each captioned in a hard-edged slab ON the picture. The caption
         being the last text inside the panel is also what keeps the following
         rhythm boundary honest: an image with no text below it gets swallowed
         into the gap, which is a failure mode www-rhythm.mjs records. -->
    <!-- The bottom padding is not decoration. The last text in this scope is a
         caption sitting ON the photograph, so without it the boundary to the
         next section measures from the panel's bottom edge and came in at
         152px against a 190–450 band. -->
    <section id="anywhere" class="rule-top px-5 py-section sm:px-8 lg:py-section-lg">
      <div class="mx-auto max-w-6xl">
        <p class="eyebrow">{ANYWHERE.eyebrow}</p>
        <h2 class="display-section mt-4 max-w-[24ch]">{ANYWHERE.heading}</h2>
      </div>

      <div class="mt-12 grid gap-0.5 bg-rule md:grid-cols-3">
        {ANYWHERE.panels.map((p, i) => (
          <figure class="stage on-dark relative flex min-h-[78svh] items-end md:min-h-[86svh]">
            <StagePhoto base={p.base} alt={p.alt} position={i === 1 ? '50% 60%' : '50% 45%'} drift />
            <figcaption class="stage-body slab w-full px-5 py-6 sm:px-6">
              <p class="text-[19px] font-extrabold tracking-[-0.01em]">{p.title}</p>
              <p class="mt-2 max-w-[36ch] text-[15px] leading-[1.5] text-quiet">{p.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 06 FREE. The one contrasting field, about two-thirds down — the shape
         §11.3 measured (Freeletics Nutrition's light band at y=2550, TrainHeroic
         B's accent band at y=3150). Ink, not a new colour: --foreground used as
         a ground, so check-token-sync and check-design-system see nothing new.
         It also carries the mid-page repeat of the action, inverted to paper so
         the page still spends exactly one red control. -->
    <section id="free" class="ground-ink px-5 py-section sm:px-8 lg:py-section-lg">
      <div class="mx-auto max-w-6xl">
        <p class="eyebrow">{FREE_CORE.eyebrow}</p>
        <h2 class="display-section mt-4 max-w-[24ch]">{FREE_CORE.heading}</h2>
        <dl class="mt-10 divide-y-2 divide-rule border-y-2 border-rule">
          {FREE_CORE.rows.map((row) => (
            <div class="grid gap-2 py-5 sm:grid-cols-[14rem_1fr] sm:gap-8">
              <dt class="text-[17px] font-extrabold tracking-[-0.01em]">{row.term}</dt>
              <dd class="max-w-[62ch] text-[16px] leading-[1.6] text-quiet">{row.def}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 max-w-[62ch] text-[15px] leading-[1.6] text-quiet">
          {FREE_CORE.footnote}
        </p>
        <CtaSlot variant="quiet" class="mt-9" />
      </div>
    </section>

    <!-- 07 COMPARE RAIL. The crop is the affordance: the next card is cut by the
         viewport edge rather than announced by an arrow. Ten real stories, so
         the rail has something to be a rail about. The ten pages themselves stay
         on the Next app — see ../lib/appLinks. -->
    <Section id="compare">
      <p class="eyebrow">{COMPARE.eyebrow}</p>
      <h2 class="display-section mt-4 max-w-[24ch]">{COMPARE.heading}</h2>
      <div class="mt-10 rail">
        {COMPARE.stories.map((story) => (
          <a
            href={appUrl(`/compare/${story.slug}`)}
            class="flex flex-col gap-3 border-2 border-rule bg-card p-5 hover:bg-tint"
          >
            <span class="eyebrow">{story.eyebrow}</span>
            <span class="text-[17px] font-extrabold leading-[1.2] tracking-[-0.01em]">
              {story.title}
            </span>
          </a>
        ))}
      </div>
      <p class="eyebrow mt-4">{COMPARE.stories.length} stories · scroll</p>
    </Section>

    <!-- 08 QUESTIONS. `<details>`, so it opens with JavaScript disabled. -->
    <Section id="questions">
      <p class="eyebrow">{QUESTIONS.eyebrow}</p>
      <h2 class="display-section mt-4 max-w-[24ch]">{QUESTIONS.heading}</h2>
      <div class="mt-10 max-w-3xl divide-y-2 divide-rule border-y-2 border-rule">
        {QUESTIONS.items.map((item) => (
          <details class="faq py-2">
            <summary class="flex items-center gap-4 py-3 text-[17px] font-extrabold tracking-[-0.01em]">
              {item.q}
            </summary>
            <p class="max-w-[62ch] pb-4 text-[16px] leading-[1.6] text-quiet">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </Section>
  </main>

  <!-- 09 START. The page's one red field. poster-FIELD, not poster-close: it
       carries a 13px reassurance line, and paper on #ec3013 is 4.19:1 — fine
       for display, short of the 4.5:1 small text needs. --primary is 6.5:1. -->
  <footer class="poster-field px-5 py-statement sm:px-8 lg:py-statement-lg">
    <div class="mx-auto max-w-6xl">
      <p class="display-statement wipe"><span>{STATEMENTS.close}</span></p>
      <CtaSlot class="mt-10 max-w-[420px]" />
    </div>
  </footer>

  <script>
    /*
     * Two moves that CSS cannot do alone, in ~1KB and with no framework.
     *
     * 1. The nav swaps ground when the photographic hero leaves. An
     *    IntersectionObserver on a sentinel, not a scroll handler — nothing here
     *    runs per frame.
     * 2. The stat figures count up once, when they first come into view.
     *    `animateCount` is COPIED from src/lib/motion.ts rather than imported:
     *    wwwSurface.test.ts asserts this surface never imports app code at
     *    runtime, and a 20-line easing function is not worth a bundle edge.
     *    `.display-mega` already sets tabular-nums so the figure cannot jitter.
     */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- nav ground swap ----------------------------------------------------
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const hero = document.querySelector<HTMLElement>('main > section');
    if (nav && hero) {
      const onDark = () => {
        nav.classList.add('on-dark');
        nav.classList.remove('bg-paper', 'border-rule');
        nav.classList.add('border-transparent');
      };
      const onPaper = () => {
        nav.classList.remove('on-dark', 'border-transparent');
        nav.classList.add('bg-paper', 'border-rule');
      };
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? onDark() : onPaper()),
        // Fire when the hero's bottom passes the nav's own height.
        { rootMargin: '-72px 0px 0px 0px', threshold: 0 },
      ).observe(hero);
    }

    // --- stat count-up ------------------------------------------------------
    function animateCount(
      from: number,
      to: number,
      durationMs: number,
      onFrame: (value: number) => void,
    ) {
      if (reduced || from === to) {
        onFrame(to);
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / durationMs);
        const eased = 1 - Math.pow(1 - t, 3);
        onFrame(Math.round(from + (to - from) * eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    const figures = [...document.querySelectorAll<HTMLElement>('[data-stat-figure]')];
    if (figures.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            observer.unobserve(el);

            // Only figures that are a plain number count. `3min` and `$0` carry
            // a unit, and animating a string by slicing digits out of it is how
            // a stat ends up briefly reading `$0` as `0`.
            const raw = el.dataset.statFigure ?? '';
            if (!/^\d+$/.test(raw)) continue;
            const target = Number(raw);
            animateCount(0, target, 900, (v) => {
              el.textContent = String(v);
            });
          }
        },
        { threshold: 0.6 },
      );
      for (const el of figures) observer.observe(el);
    }
  </script>
</Base>
