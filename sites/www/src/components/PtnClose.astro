---
/*
 * Notify close — same cadence as the old poster field (py-statement) so
 * www-rhythm stays in band. Black pill, no poster red on this costume.
 */
import CtaSlot from './CtaSlot.astro';

interface Props {
  line: string;
  terminal?: boolean;
}

const { line, terminal = true } = Astro.props;
---

<footer class="px-5 py-statement sm:px-8 lg:py-statement-lg">
  <div class="mx-auto max-w-6xl">
    <p class="display-statement wipe"><span>{line}</span></p>
    <CtaSlot terminal={terminal} class="mt-10 max-w-[420px]" />
  </div>
</footer>
