---
/*
 * Sticky 64px nav — Patreon structure, modernist tokens.
 * Shared so every www page inherits the same chrome.
 */
import CtaSlot from './CtaSlot.astro';
import { INVITE_URL } from '../lib/appLinks';
import { NAV_LINKS } from '../lib/homeContent';

interface Props {
  /** Photo heroes start on-dark and swap to paper via the page script. */
  onDark?: boolean;
}

const { onDark = true } = Astro.props;
---

<header
  class:list={[
    'fixed inset-x-0 top-0 z-50 border-b-2 transition-colors duration-200',
    onDark ? 'on-dark border-transparent' : 'border-rule bg-paper',
  ]}
  data-nav
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8">
    <a href="/" class="flex shrink-0 items-center gap-3">
      <span
        class="flex h-8 w-8 items-center justify-center bg-paper text-[13px] font-extrabold tracking-[-0.04em] text-ink"
        data-nav-mark>MW</span
      >
      <span class="text-[15px] font-extrabold tracking-[-0.01em]">Mission Winning</span>
    </a>
    <nav class="hidden flex-1 items-center justify-center gap-7 md:flex" aria-label="Product">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="text-[14px] font-semibold text-quiet hover:text-ink hover:underline">
          {l.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-4">
      <a
        href={INVITE_URL}
        class="hidden min-h-[44px] items-center text-[14px] font-semibold md:inline-flex"
      >
        Enter with code
      </a>
      <CtaSlot variant="quiet" class="shrink-0" />
    </div>
  </div>
</header>
