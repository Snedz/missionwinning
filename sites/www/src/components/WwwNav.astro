---
/*
 * Sticky 64px nav — left cluster / center wordmark / one quiet CTA.
 * Patreon structure, modernist tokens. Shared so every www page inherits it.
 */
import CtaSlot from './CtaSlot.astro';
import { INVITE_URL } from '../lib/appLinks';
import { NAV_LINKS } from '../lib/homeContent';

interface Props {
  /** Photo heroes start on-dark and swap to paper via the page script. */
  onDark?: boolean;
}

const { onDark = true } = Astro.props;
---

<header
  class:list={[
    'fixed inset-x-0 top-0 z-50 border-b-2 transition-colors duration-200',
    onDark ? 'on-dark border-transparent' : 'border-rule bg-paper',
  ]}
  data-nav
>
  <div class="mx-auto grid h-16 max-w-6xl grid-cols-[1fr_auto_1fr] items-center px-5 sm:px-8">
    <nav class="hidden items-center justify-start gap-7 md:flex" aria-label="Product" data-mw-nav-cluster>
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="text-[14px] font-semibold text-quiet hover:text-ink hover:underline">
          {l.label}
        </a>
      ))}
    </nav>
    <a
      href="/"
      class="justify-self-center text-[15px] font-extrabold tracking-[-0.01em]"
    >
      Mission Winning
    </a>
    <div class="flex items-center justify-end gap-4">
      <a
        href={INVITE_URL}
        class="hidden min-h-[44px] items-center text-[14px] font-semibold md:inline-flex"
      >
        Enter with code
      </a>
      <CtaSlot variant="quiet" class="shrink-0" />
    </div>
  </div>
</header>
